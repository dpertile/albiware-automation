{
  "name": "albiware-automation",
  "version": "1.0.0",
  "description": "Automação segura de cascata de tarefas para Albiware",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc || true",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "db:rollback": "node dist/db/rollback.js",
    "dry-run": "DRY_RUN=true ts-node src/index.ts",
    "safe-test": "DRY_RUN=true NODE_ENV=test ts-node src/index.ts",
    "audit:logs": "node dist/scripts/auditLogs.js",
    "audit:conflicts": "node dist/scripts/checkConflicts.js",
    "stop:emergency": "node dist/scripts/emergencyStop.js",
    "rollback:last": "node dist/scripts/rollbackLast.js"
  },
  "keywords": [
    "albiware",
    "automation",
    "cascade-tasks",
    "project-management"
  ],
  "author": "Quick Response Restoration",
  "license": "PROPRIETARY",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "redis": "^4.6.12",
    "bull": "^4.11.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
