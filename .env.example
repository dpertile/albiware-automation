# ============================================================
# ALBIWARE AUTOMATION - CONFIGURAÇÃO
# ============================================================

# Ambiente
NODE_ENV=staging
# Opções: development | staging | production

# DRY RUN - MODO SEGURO (simula sem fazer ações reais)
DRY_RUN=true
# Mude para false apenas APÓS validar tudo em staging

# Validações
VALIDATE_ALL_ACTIONS=true
LOG_ALL_REQUESTS=true
ENABLE_ROLLBACK=true
ENABLE_ALERTS=true

# ============================================================
# API ALBIWARE
# ============================================================

ALBIWARE_API_KEY=304784df-ebfe-439c-bb9d-b0bd521f6c9e
ALBIWARE_API_BASE_URL=https://api.albiware.com/v5/Integrations
API_TIMEOUT_MS=30000
API_MAX_RETRIES=3
API_RETRY_BACKOFF_MS=1000

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=automation
DB_PASSWORD=change_me_in_production
DB_NAME=albiware_automation
DB_SSL=false
# Mude para true em produção

# ============================================================
# RATE LIMITING
# ============================================================

MAX_REQUESTS_PER_SECOND=10
MAX_TASKS_PER_HOUR=100
MAX_DATES_PER_HOUR=50

# ============================================================
# MONITORING & ALERTS
# ============================================================

ENABLE_AUDIT_LOG=true
ALERT_ON_ERROR=true
ALERT_CHANNEL=slack
# Opções: slack | email | both

# Slack Webhook (se usando Slack)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Recipients (se usando Email)
# Separar com vírgula: email1@example.com,email2@example.com
EMAIL_RECIPIENTS=

# ============================================================
# ISOLATION & SAFETY
# ============================================================

AUTOMATION_TAG=automated-cascade-v1
AUTOMATION_OWNER=system-automation
# Opções: strict | moderate | loose
ISOLATION_MODE=strict

# ============================================================
# WEBHOOKS - DETECTAR CONFLITOS
# ============================================================

# IDs de webhooks já ativos (verificar em Albiware settings)
# Formato: número,número,número
KNOWN_WEBHOOK_IDS=15802
# 15802 = Zapier webhook para project.date.updated

# Verificar colisão com webhooks conhecidos?
WEBHOOK_COLLISION_CHECK=true
# Se detectar conflito, qual ação tomar?
# Opções: pause_automation | log_only | continue
WEBHOOK_CONFLICT_ACTION=pause_automation

# ============================================================
# CASCADE CONFIGURATION
# ============================================================

# Quais tipos de projeto aplicar automação?
PROJECT_TYPES=Biohazard,Emergency Services,Mold,Sewage,Structural Cleaning,Water

# ============================================================
# SERVER (Webhooks locais)
# ============================================================

SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ============================================================
# NOTAS DE SEGURANÇA
# ============================================================

# 1. STAGING:
#    - DRY_RUN=true (não faz ações reais)
#    - NODE_ENV=staging
#    - Use projeto teste (ex: 26-99999-TEST)
#    - Teste por 24h+ sem erros

# 2. PRODUÇÃO:
#    - DRY_RUN=false (apenas após staging OK)
#    - NODE_ENV=production
#    - DB com backup automático
#    - Alertas configurados
#    - Equipe treinada

# 3. MONITORAMENTO:
#    - Todos os logs em arquivo + console
#    - Alertas automáticos em erro
#    - Dashboard de auditoria
#    - Relatório diário

# 4. EMERGÊNCIA:
#    - Script de parada: npm run stop:emergency
#    - Script de rollback: npm run rollback:last
#    - Manter backups do DB

# ============================================================
